{
  "python.defaultInterpreterPath": "${workspaceFolder}/mcp-server/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}/mcp-server"],
  "files.exclude": {
    "**/__pycache__": true,
    "**/.venv": true
  },
  "search.exclude": {
    "sources/cache/_raw": true,
    "mcp-server/.venv": true
  },
  "markdown.validate.enabled": true,
  "chat.tools.terminal.autoApprove": {
    "/^python3 scripts/build_topic_index\\.py$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "chat.agent.maxRequests": 5000
}
